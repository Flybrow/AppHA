[Unit]
Description=Mise à jour de HA Kiosk depuis GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Sortie 3 = déjà à jour. Le kiosk n'est redémarré qu'après une installation.
SuccessExitStatus=3
ExecCondition=/bin/sh -c '! grep -Eq "^[[:space:]]*auto_update[[:space:]]*=[[:space:]]*false" /etc/ha-kiosk/config.toml'
ExecStart=/bin/sh -c '/usr/local/bin/ha-kiosk update && systemctl try-restart ha-kiosk.service'
