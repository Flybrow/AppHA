[Unit]
Description=HA Kiosk (dashboard Home Assistant)
After=network-online.target systemd-user-sessions.service
Wants=network-online.target

[Service]
User=%KIOSK_USER%
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardError=journal
# PAMName= puts the processes in the session: `journalctl -u` does not see them.
# Logs : journalctl -t ha-kiosk -f
SyslogIdentifier=ha-kiosk
Environment=XDG_RUNTIME_DIR=/run/user/%KIOSK_UID%
# WebKit's bubblewrap sandbox fails under this service ("Unexpected capabilities"):
# black screen. The kiosk only shows Home Assistant, so it is disabled.
Environment=WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1
TimeoutStopSec=10
# Touchscreen follows the screen rotation (root: writes a udev rule).
ExecStartPre=+/usr/local/lib/ha-kiosk/touch-rotation.sh /etc/ha-kiosk/config.toml
# cage: single-application Wayland compositor (no desktop, no window manager).
ExecStart=/usr/bin/cage -d -- /usr/local/bin/ha-kiosk --config /etc/ha-kiosk/config.toml run
# on-failure: "Quit the kiosk" (normal exit) stops the service.
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
